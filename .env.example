# ── Meta Model API ─────────────────────────────────────────────
# Get a key at https://dev.meta.ai → API keys → Create API key.
# Server-side only: the browser never sees it. Leave empty for demo mode.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Models (defaults shown — change only if your account uses other IDs)
META_TEXT_MODEL=muse-spark-1.3
META_SEG_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0
META_ASR_MODEL=muse-voice-transcribe-1.0
# minimal | low | medium | high — lower is faster and cheaper for layout JSON
META_REASONING_EFFORT=low

# SAM 3.1 concepts, one request each (fewer = faster/cheaper)
SAM_CONCEPTS=floor,wall,window,door,sofa,chair,table,bed,cabinet,lamp

# ── Server ─────────────────────────────────────────────────────
PORT=5173
# Max AI requests per visitor IP per 10 minutes (0 = unlimited)
RATE_LIMIT_PER_10MIN=60

# Hostnames the app is served from, comma-separated (e.g. www.example.com). Used by the dev
# server and to build the Google sign-in redirect for each host. localhost always works.
ALLOWED_HOSTS=

# ── Accounts ───────────────────────────────────────────────────
# Public address of the app (used for the Google sign-in redirect), e.g. https://www.example.com
PUBLIC_URL=
# Google sign-in (optional): Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URIs: <PUBLIC_URL>/api/auth/google/callback and http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verification emails for email + password sign-ups (Resend → API Keys, "Sending access" for your verified domain).
# Without a key the development server prints the code to the console; in production sign-ups stay unverified.
RESEND_API_KEY=
# MAIL_FROM=Tataloka <noreply@tataloka.com>
# Where the SQLite database (accounts, sessions, saved designs, renders, credits) is stored. Default: ./data
# DATA_DIR=

# Monthly AI credits per account (plans in src/data/plans.js). Set to off to disable.
# CREDITS=on
